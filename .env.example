# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# ── Public URLs ───────────────────────────────────────────────────────────────
# Single Railway service serves BOTH the API and the React build, so both of
# these are the SAME origin in production — your custom domain.
# These drive the Google OAuth redirect; if they point at an old domain you will
# be bounced to the old deployment (old UI) after Google sign-in.
FRONTEND_URL=https://www.graspr.in
BACKEND_URL=https://www.graspr.in

# ── Database ──────────────────────────────────────────────────────────────────
# Railway Postgres connection string (required — no SQLite fallback).
DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Override default model (default: anthropic/claude-haiku-4-5)
AI_MODEL=anthropic/claude-haiku-4-5
# Your deployed URL — sent as HTTP-Referer to the OpenRouter dashboard
APP_URL=https://www.graspr.in

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client.
# Authorized redirect URI must be:  https://www.graspr.in/api/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Without RESEND_API_KEY the OTP is just printed to the server console (dev mode).
# RESEND_FROM_EMAIL must be on a domain you've verified in Resend (graspr.in).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@graspr.in

# ── Admin bootstrap ───────────────────────────────────────────────────────────
ADMIN_USERNAMES=tarun

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_AI_AUTHORING=true

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
VITE_SENTRY_DSN=https://...@sentry.io/...

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
# Client-side only — safe to expose (write-only project key, not a secret).
# Never fires until a user accepts the cookie-consent banner (see
# client/src/analytics.js + CookieConsent.jsx).
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Logging (BetterStack Logtail) ─────────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=...
