# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────────
# On Railway: set to /data/varc.db (persistent volume mounted at /data)
# Locally: leave unset (defaults to varc.db in repo root)
DB_PATH=/data/varc.db

# ── AI (OpenRouter) ───────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Override default model (default: anthropic/claude-haiku-4-5)
# Browse models at https://openrouter.ai/models
AI_MODEL=anthropic/claude-haiku-4-5
# Your deployed URL — sent as HTTP-Referer to OpenRouter dashboard
APP_URL=https://your-app.up.railway.app

# ── Admin bootstrap ───────────────────────────────────────────────────────────
ADMIN_USERNAMES=tarun

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_AI_AUTHORING=true

# ── Error monitoring (Sentry) ─────────────────────────────────────────────────
# Backend DSN — from sentry.io → Node.js project
SENTRY_DSN=https://...@sentry.io/...
# Frontend DSN — baked into the React build at build time
VITE_SENTRY_DSN=https://...@sentry.io/...

# ── Logging (BetterStack Logtail) ─────────────────────────────────────────────
# Source token from betterstack.com → Logs → your source
BETTERSTACK_SOURCE_TOKEN=...
